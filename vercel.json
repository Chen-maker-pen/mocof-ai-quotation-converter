{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:mocofPath*",
      "destination": "/api?__mocof_path=:mocofPath*"
    },
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}
